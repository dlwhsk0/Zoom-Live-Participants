# 호스트 판정 PoC 전용. 루트 .env 와는 별개다.
# `.env*` 는 .gitignore 에 걸려 있으므로 .env 는 커밋되지 않는다.

# Marketplace 에서 만든 **Meeting SDK 앱**의 자격증명.
# 루트 .env 의 ZOOM_CLIENT_ID/SECRET(Server-to-Server OAuth)과는 다른 값이다.
# 반드시 회의방을 소유한 계정(techeer1)으로 만들어야 한다 — 그래야 내부 회의
# 예외에 걸려서 OBF 토큰도 앱 심사도 없이 JWT 서명만으로 붙는다.
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=

# 붙을 회의. 공백은 알아서 지운다.
ZOOM_MEETING_ID=
ZOOM_MEETING_PASSCODE=

# 회의 참가자 목록에 뜨는 이름. 사람이 보고 봇인 줄 알 수 있게 둔다.
ZOOM_BOT_NAME=출석봇(테스트)

# 서버 포트 (기본 5199). API 3000, 프론트 5180 과 겹치지 않게 잡았다.
PORT=5199
