# ── 백엔드 (Dokploy) ──────────────────────────────────
# PostgreSQL 연결 문자열
DATABASE_URL=

# Zoom Event Subscription 의 Secret Token.
# 없으면 웹훅 요청을 거부한다(fail-closed).
ZOOM_WEBHOOK_SECRET_TOKEN=

# 기본 조회 대상 회의방 번호. 세션이 바뀌어도 고정이다.
ZOOM_MEETING_ID=

# 서버 포트 (기본 3000)
PORT=3000

# 메트릭 전용 포트 (기본 9091).
# 이 포트를 도메인에 연결하지 않으면 /metrics 는 외부에 노출되지 않는다.
METRICS_PORT=9091

# 설정하면 /metrics 에 Bearer 토큰 또는 ?token= 을 추가로 요구한다.
METRICS_TOKEN=

# 로그 조회 토큰. /logs 화면과 GET /api/logs 에 필요하다.
# 로그에는 참가자 이름과 IP 가 그대로 담긴다.
# 비워두면 로그 API 가 503 으로 막힌다 (실수로 열리는 것보다 안 열리는 게 낫다).
LOGS_TOKEN=

# CORS 허용 오리진. 프론트가 다른 도메인에 있으므로 필요하다.
# 세 가지 표기를 모두 받는다.
#   https://a.com
#   https://a.com,https://b.com
#   ["https://a.com", "https://b.com"]
# 끝의 슬래시는 자동으로 떼어낸다 (Origin 헤더에는 슬래시가 없다).
# 비우면 모두 허용 — 로컬 개발용이며 운영에서는 반드시 지정한다.
CORS_ALLOWED_ORIGINS=

# ── 프론트 (Vercel) ───────────────────────────────────
# 백엔드 API 주소. 비우면 같은 도메인의 /api 를 쓴다.
# 예: https://api.example.com
VITE_API_BASE=

# 조회할 회의방 번호. 비우면 백엔드의 ZOOM_MEETING_ID 를 쓴다.
VITE_MEETING_ID=

# ── Zoom REST API (현재 코드에서는 쓰지 않음) ──────────
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
