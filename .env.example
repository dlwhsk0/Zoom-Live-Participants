# ── 백엔드 (Dokploy) ──────────────────────────────────
# PostgreSQL 연결 문자열
DATABASE_URL=

# Zoom Event Subscription 의 Secret Token.
# 없으면 웹훅 요청을 거부한다(fail-closed).
ZOOM_WEBHOOK_SECRET_TOKEN=

# 기본 조회 대상 회의방 번호. 세션이 바뀌어도 고정이다.
ZOOM_MEETING_ID=

# 서버 포트 (기본 3000)
PORT=3000

# 메트릭 전용 포트 (기본 9091).
# 이 포트를 도메인에 연결하지 않으면 /metrics 는 외부에 노출되지 않는다.
METRICS_PORT=9091

# 설정하면 /metrics 에 Bearer 토큰 또는 ?token= 을 추가로 요구한다.
METRICS_TOKEN=

# 로그 조회 토큰. /logs 화면과 GET /api/logs 에 필요하다.
# 로그에는 참가자 이름과 IP 가 그대로 담긴다.
# 비워두면 로그 API 가 503 으로 막힌다 (실수로 열리는 것보다 안 열리는 게 낫다).
LOGS_TOKEN=

# 조회 API 공유 토큰. 설정하면 /api/participants 와 상태 메시지 쓰기에
# x-access-token 헤더를 요구한다. 비우면 검사하지 않는다.
#
# **HTTP 헤더 제약으로 공백 없는 ASCII 여야 한다.** 한글을 넣으면 브라우저가
# 아예 보내지 못해 화면이 조용히 401 로 죽는다 — 기동할 때 걸러낸다.
# 프론트의 VITE_ACCESS_TOKEN 과 같은 값을 넣는다. 예: openssl rand -hex 24
ACCESS_TOKEN=

# 세션 쿠키 서명 키. 로그인 기능에 필요하다.
# 비워두면 로그인이 꺼진다(서명 없는 세션을 발급하느니 막는 쪽).
# 바꾸면 발급된 세션이 전부 끊긴다. 예: openssl rand -base64 32
SESSION_SECRET=

# CORS 허용 오리진. 프론트가 다른 도메인에 있으므로 필요하다.
# 세 가지 표기를 모두 받는다.
#   https://a.com
#   https://a.com,https://b.com
#   ["https://a.com", "https://b.com"]
# 끝의 슬래시는 자동으로 떼어낸다 (Origin 헤더에는 슬래시가 없다).
# 비우면 모두 허용 — 로컬 개발용이며 운영에서는 반드시 지정한다.
CORS_ALLOWED_ORIGINS=

# ── 프론트 (Vercel) ───────────────────────────────────
# 백엔드 API 주소. 비우면 같은 도메인의 /api 를 쓴다.
# 예: https://api.example.com
VITE_API_BASE=

# 조회할 회의방 번호. 비우면 백엔드의 ZOOM_MEETING_ID 를 쓴다.
VITE_MEETING_ID=

# 조회 API 공유 토큰. 백엔드의 ACCESS_TOKEN 과 같은 값.
# 빌드에 박혀 나가므로 감추는 값이 아니다 — 번들을 받을 수 있는 사람에게만
# 주는 값이다. 사이트를 공용 비밀번호로 잠그지 않으면 이 토큰도 같이 공개된다.
VITE_ACCESS_TOKEN=

# 어드민 화면 주소. 비우면 /admin.
# 레포가 공개라 코드에 적으면 그 순간 공개된다. 감추려면 배포 환경변수에만 넣는다.
# 다만 주소를 감추는 것은 자물쇠가 아니다 — 그 화면은 로그인으로 막혀 있다.
VITE_ADMIN_PATH=

# ── Vercel 엣지 (사이트 공용 비밀번호) ────────────────
# 넣으면 사이트 전체에 브라우저 로그인 창이 뜬다. 비우면 켜지지 않는다.
BASIC_AUTH_PASSWORD=

# 아이디는 보통 비워 둔다. 비워두면 아이디 칸에 무엇을 넣든(비워도) 통과한다.
# 프로토콜상 아이디 칸 자체를 없앨 수는 없지만, 검사하지 않으면 없는 것과 같다.
# 아이디도 함께 요구하고 싶을 때만 넣는다.
BASIC_AUTH_USER=

# ── Zoom REST API (현재 코드에서는 쓰지 않음) ──────────
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
