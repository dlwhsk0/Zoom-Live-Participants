# Zoom App (Server-to-Server OAuth)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# 조회 대상 회의방 번호. 세션이 바뀌어도 고정이다.
ZOOM_MEETING_ID=

# Zoom Event Subscription 의 Secret Token.
# 없으면 웹훅 요청을 거부한다(fail-closed).
ZOOM_WEBHOOK_SECRET_TOKEN=

# PostgreSQL 연결 문자열.
# 서버리스에서 붙으므로 pooling 을 지원하는 연결을 쓴다.
DATABASE_URL=
